# --- Supabase ---
# Uygulama sorguları: Supavisor pooler (transaction mode, port 6543)
DATABASE_URL=postgresql://postgres.<proje-ref>:<sifre>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# Migration'lar için doğrudan bağlantı (port 5432)
DIRECT_DATABASE_URL=postgresql://postgres:<sifre>@db.<proje-ref>.supabase.co:5432/postgres
SUPABASE_URL=https://<proje-ref>.supabase.co
# Eski (HS256) projelerde: Dashboard → Settings → API → JWT Secret. Yeni projelerde boş bırak (JWKS kullanılır).
SUPABASE_JWT_SECRET=

# --- AI sağlayıcıları ---
OPENAI_API_KEY=sk-...
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# Inworld TTS (ikinci sağlayıcı; aktif olan admin panelden seçilir). Portal → API Keys → Base64 kopya, aynen yapıştır.
INWORLD_API_KEY=NWh3aERKTkVSeVpFN21zTGNKMU4takJJbHlwV25KNTE6WEt0MF9KRkZXSVB5Y21WclhYdlVXdA==
