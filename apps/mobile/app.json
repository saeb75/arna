{
  "expo": {
    "name": "GlotMate",
    "slug": "glotmate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "scheme": "glotmate",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": {
        "light": "./assets/brand/icon.png",
        "dark": "./assets/brand/icon-dark.png",
        "tinted": "./assets/brand/icon-tinted.png"
      },
      "bundleIdentifier": "com.imtiyaz.glotmate",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f25f2a",
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "backgroundImage": "./assets/brand/adaptive-background.png",
        "monochromeImage": "./assets/brand/adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.imtiyaz.glotmate",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash-mark.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#f8f6f4",
          "dark": {
            "backgroundColor": "#140e0b",
            "image": "./assets/brand/splash-mark.png"
          }
        }
      ],
      "expo-audio",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "color": "#b94d17"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "689a6aee-3f58-43f8-858c-7c1a704a15b0"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/689a6aee-3f58-43f8-858c-7c1a704a15b0"
    }
  }
}
