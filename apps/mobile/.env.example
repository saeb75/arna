EXPO_PUBLIC_API_URL=http://localhost:6560
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Avatar sayfası (apps/web /embed/avatar). Boş = avatar kapalı, ders sesli devam eder.
# iOS simülatör: localhost çalışır · Android emülatör: http://10.0.2.2:6567/embed/avatar
# Gerçek cihaz: Mac'in LAN IP'si (örn. http://192.168.1.20:6567/embed/avatar)
EXPO_PUBLIC_AVATAR_URL=http://localhost:6567/embed/avatar

# AppsFlyer (kurulum ölçümü; geliştirmede kapalı — EXPO_PUBLIC_ATTRIBUTION_IN_DEV=1 ile açılır).
# APP_ID = App Store'daki sayısal uygulama kimliği (iOS onsuz başlamaz).
EXPO_PUBLIC_APPSFLYER_DEV_KEY=
EXPO_PUBLIC_APPSFLYER_APP_ID=
